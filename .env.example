# NAVER Cloud Platform API credentials
NCP_ACCESS_KEY_ID=
NCP_SECRET_KEY=

# SENS SMS project and registered sender
NCP_SENS_SERVICE_ID=ncp:sms:kr:YOUR_PROJECT_ID:sens
NCP_SENS_FROM_NUMBER=01012345678

# Must be reviewed before live sending: COMM (general) or AD (advertisement)
SENS_CONTENT_TYPE=REVIEW_REQUIRED

# Keep true until live-send approval and preflight checks are complete
SENS_DRY_RUN=true
